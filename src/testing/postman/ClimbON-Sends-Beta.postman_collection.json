            ]
          }
        }
      ]
    },
    {
      "name": "13. RLS - anonymous user cannot upload videos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{ANON_KEY}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ANON_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "video/mp4"
          }
        ],
        "url": {
          "raw": "{{SUPABASE_URL}}/storage/v1/object/beta-videos/{{user_id}}/postman-anon-{{$timestamp}}.mp4",
          "host": [
            "{{SUPABASE_URL}}"
          ],
