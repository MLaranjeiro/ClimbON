              "  pm.expect(String(beta.route.id)).to.eql(String(pm.collectionVariables.get('route_id')));",
              "  pm.expect(beta.route.route_name).to.eql(pm.collectionVariables.get('route_name'));",
              "});"
            ]
          }
        }
      ]
    },
    {
