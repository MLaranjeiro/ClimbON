          "script": {
            "exec": [
              "// Same query the profile page runs (Dashboard).",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const beta = pm.response.json().find((b) => String(b.id) === String(pm.collectionVariables.get('beta_id')));",
              "pm.test('new beta is listed on the profile', () => pm.expect(beta).to.exist);",
