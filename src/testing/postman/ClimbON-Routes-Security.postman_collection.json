    {
      "name": "17. TC-08 - SQL injection in an eq filter",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{ANON_KEY}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{SUPABASE_URL}}/rest/v1/routes?route_name=eq.' OR 1=1 --&select=id",
          "host": [
            "{{SUPABASE_URL}}"
          ],
          "path": [
            "rest",
            "v1",
            "routes"
          ],
          "query": [
            {
              "key": "route_name",
              "value": "eq.' OR 1=1 --"
            },
            {
              "key": "select",
              "value": "id"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('payload is treated as a literal value, not SQL', () => {",
              "  if (pm.response.code === 200) {",
              "    pm.expect(pm.response.json()).to.have.lengthOf(0);",
              "  } else {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 406, 422]);",
              "  }",
              "});",
              "pm.test('no database error details are leaked', () => pm.expect(pm.response.text()).to.not.match(/syntax error at or near/i));"
            ]
          }
        }
      ]
    },
