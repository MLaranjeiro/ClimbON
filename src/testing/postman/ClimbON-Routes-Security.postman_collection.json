    {
      "name": "15. Session - tampered JWT is rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{ANON_KEY}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}tampered"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{SUPABASE_URL}}/rest/v1/routes?select=id&limit=1",
          "host": [
            "{{SUPABASE_URL}}"
          ],
          "path": [
            "rest",
            "v1",
            "routes"
          ],
          "query": [
            {
              "key": "select",
              "value": "id"
            },
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('modified token signature is rejected with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
